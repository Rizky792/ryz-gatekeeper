# Copy to .env and fill in. NEVER commit .env (it holds secrets).
# Secret source: Agent Games dashboard -> My Agents -> Rotate Secret
# (shown once). The Kurier API key is optional; without it, proof
# submission via Kurier is skipped (local snarkjs verification is used).

AGENT_GAMES_HMAC_SECRET=
ZKVERIFY_RPC_URL=
AGENT_ENDPOINT_URL=
KURIER_API_KEY=
PORT=8080

# The vk hash this agent registered for its statements (0x...). When set, the
# agent rejects tasks whose registered_vk differs (unregistered_vk). Leave
# empty to skip that check. Defaults to the gatekeeper circuit vkHash when
# the agent is registered with it.
REGISTERED_VK=

# Optional policy caps (applied on top of the circuit's own checks):
# POLICY_MAX_TRANSFER_CAP — refuse any approval above this amount.
# POLICY_MIN_BALANCE — refuse unless the statement's publicBalance is >= this.
# POLICY_REQUIRE_BALANCE_COVERS_AMOUNT=1 — refuse when publicBalance < amount.
#   (The circuit does NOT check balance >= amount; this is an opt-in
#   stricter gate. Default off.)
# POLICY_MAX_TRANSFER_CAP=
# POLICY_MIN_BALANCE=
# POLICY_REQUIRE_BALANCE_COVERS_AMOUNT=

# Timeouts (seconds unless noted). The platform deadline is 60s; the request
# timeout must stay under it.
# TASK_MAX_AGE_SECONDS=300
# KURIER_TIMEOUT_MS=30000
# REQUEST_TIMEOUT_MS=55000

# Paths (defaults: ./circuits and ./data under the working directory).
# CIRCUITS_DIR=
# DATA_DIR=
